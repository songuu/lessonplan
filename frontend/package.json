{
  "name": "lesson-assistant-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src vite.config.ts vitest.config.ts package.json tsconfig.json index.html"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dompurify": "^3.2.6",
    "katex": "0.18.2",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "5.0.5"
  }
