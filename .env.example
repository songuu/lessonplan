# 本地演示；真实 Secret 只放忽略的 .env 或运行环境。
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./lesson_assistant.db
TASK_QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379/0
AI_PROVIDER=mock
JWT_SECRET=local-development-only-change-before-production
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ONE_CLICK_MODEL=
LLM_STRUCTURED_MODEL=
LLM_MODULE_OPERATION_MODEL=
LLM_REVIEW_MODEL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_SECONDS=120
RUN_TIMEOUT_SECONDS=300
QUALITY_RETRY_LIMIT=1
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
WORKER_RECOVERY_LIMIT=3
DISPATCH_MAX_ATTEMPTS=6
DISPATCH_RETRY_BASE_SECONDS=2
DISPATCH_RETRY_MAX_SECONDS=60
DISPATCH_TIMEOUT_SECONDS=5
DISPATCH_DEADLINE_SECONDS=300
QUEUE_BACKLOG_SECONDS=60
KNOWLEDGE_SEARCH_MAX_CHUNKS=10000
STORAGE_BACKEND=local
STORAGE_ROOT=var/storage
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
INTERNAL_REVIEW_ENABLED=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_DIST=frontend/dist
REGISTRATION_ENABLED=true

# Optional self-hosted Langfuse. Local /admin execution logs always remain enabled.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT=lesson-assistant
OBS_DEPLOYMENT_ID=lesson-assistant-local
OBS_RELEASE=
OBS_CAPTURE_MODE=metadata
OBS_TRACE_SAMPLE_RATE=1
OBS_EXPORT_QUEUE_SIZE=512
OBS_MAX_EVENT_BYTES=16384
OBS_EXPORT_TIMEOUT_SECONDS=2
OBS_SHUTDOWN_TIMEOUT_SECONDS=5
